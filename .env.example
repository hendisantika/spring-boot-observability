# Copy to .env and edit. .env is git-ignored; .env.example is not, so never put
# real credentials in this file.
#
#   cp .env.example .env
#   docker compose up -d
#
# docker compose reads .env automatically. Values here are only defaults for
# local use — set real ones before exposing Grafana on a public hostname.

# Grafana admin login. Applied on FIRST START only: Grafana stores users in its
# own database, so changing these later has no effect on an existing install.
# To change the password afterwards, either reset the container's data or run:
#   docker compose exec grafana grafana-cli admin reset-admin-password '<new>'
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Grafana builds share links, alert links and OAuth redirects from this.
# Behind the nginx proxy set it to the public URL:
#   GF_SERVER_ROOT_URL=https://grafana.jvm.my.id
GF_SERVER_ROOT_URL=http://localhost:3000
